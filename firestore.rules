rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Una denuncia de verdad detrás de cada incremento de `reportCount`.
    //
    // ⚠️ Antes esto solo comprobaba que el delta fuera +1, y eso NO basta: la API key va
    // dentro del APK, así que cualquiera autenticado podía llamar a REST e incrementar el
    // contador las veces que quisiera **sin crear ninguna denuncia**. Con el umbral en 3,
    // eran tres llamadas para hundir cualquier plato, y sin rastro en `reports` que
    // permitiera auditarlo. El cliente sí hacía lo correcto (crear la denuncia y subir el
    // contador en una transacción), pero la regla no obligaba a nada de eso.
    //
    // `existsAfter` mira el estado DESPUÉS de la transacción: obliga a que la denuncia se
    // cree en la misma. `!exists` mira el de antes: impide que el mismo usuario vuelva a
    // sumar. El id es `{uid}_{docId}`, el mismo que construyen los tres `report*` del
    // cliente (DiscoverViewModel y PlateDetailViewModel).
    function denunciaCreadaAhora(docId) {
      let ref = /databases/$(database)/documents/reports/$(request.auth.uid + '_' + docId);
      return existsAfter(ref) && !exists(ref);
    }

    // ── BLOQUEO ENTRE USUARIOS ────────────────────────────────────────────────
    //
    // La lista vive en `users/{uid}/bloqueados/{otroUid}` y solo la toca su dueño (ver el
    // match más abajo). Estas funciones SÍ pueden leerla aunque el cliente no pueda: las
    // reglas se evalúan en el servidor, con acceso completo. Por eso la lista de quién has
    // bloqueado queda privada y aun así se puede hacer cumplir en los dos sentidos.
    //
    // ⚠️ El bloqueo es SIMÉTRICO a propósito. Si solo mirase "A bloqueó a B", el bloqueado
    // podría seguir comentando los platos de quien le bloqueó y seguirle: eso no es
    // bloquear, es ocultar, y un botón que promete lo primero y hace lo segundo es peor
    // que no tenerlo.
    //
    // Coste: cada comprobación son dos `exists()`. Sumado al `get()` del plato en
    // comentarios y valoraciones son 3 accesos, de los 10 que permite Firestore por
    // petición de documento. Si alguien añade más `get()` a esas reglas, contarlos.
    function haBloqueado(quien, aQuien) {
      return exists(/databases/$(database)/documents/users/$(quien)/bloqueados/$(aQuien));
    }
    function bloqueoEntre(otro) {
      return haBloqueado(request.auth.uid, otro) || haBloqueado(otro, request.auth.uid);
    }
    // El autor de un plato, para las reglas que necesitan saber a quién afectaría la
    // escritura. `get(...)` sobre un plato que no existe devuelve null, así que se usa el
    // acceso con valor por defecto en vez de encadenar `.data.addedByUserId`.
    function autorDelPlato(plateId) {
      return get(/databases/$(database)/documents/plates/$(plateId)).data.get('addedByUserId', '');
    }

    // Ejes de una valoración: 1..10. Ver docs/RATINGS.md.
    function scoreOk(v) { return v is number && v >= 1 && v <= 10; }
    // Campo opcional durante la convivencia de formatos: si no viene (cliente v12) o viene
    // nulo, se acepta; si viene con valor, tiene que estar en rango.
    function optScoreOk(data, key) {
      return data.get(key, null) == null || scoreOk(data.get(key, null));
    }
    // Precio pagado, en céntimos. Tope de cordura en 1.000 € para frenar erratas de teclado;
    // los valores raros que pasen el filtro los absorbe la mediana (ver docs/RATINGS.md §1.3).
    function priceOk(data) {
      return data.get('pricePaidCents', null) == null || (
        data.pricePaidCents is int
        && data.pricePaidCents > 0
        && data.pricePaidCents <= 100000
      );
    }
    function flagOk(data, key) {
      return data.get(key, null) == null || data.get(key, null) is bool;
    }
    // `valueScore` es el eje retirado (Precio/Calidad). ⚠️ El data class Rating del cliente lo
    // sigue serializando con su valor por defecto **0** aunque ya no se use — un data class de
    // Kotlin manda TODOS sus campos. Por eso aquí 0 vale como "no aplica": exigirle el rango
    // 1..10 dejaba sin poder valorar a todo el mundo (visto en el emulador con un
    // PERMISSION_DENIED real, 2026-09-20).
    function legacyScoreOk(data) {
      return data.get('valueScore', null) == null
          || data.valueScore == 0
          || scoreOk(data.valueScore);
    }

    // ── USERS ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();

      // Crear perfil: valores por defecto obligatorios para evitar XP/Premium falsos
      // Ojo con el booleano premium: el modelo Kotlin lo llama `isPremium`, pero el
      // mapper de Firestore le quita el prefijo `is` al getter y en el documento el
      // campo acaba siendo `premium`. Comprobamos las dos grafías con get(campo, false)
      // para no depender de ese detalle: falte el campo o venga con cualquiera de los
      // dos nombres, nadie puede crearse premium.
      // ⚠️ La lista blanca de abajo tiene los campos del data class User. Si se añade un
      // campo al modelo sin añadirlo aquí, falla TODA creación de usuarios (igual que en
      // plates). Y ojo: va `premium`, NO `isPremium` — ver la nota del prefijo `is`.
      allow create: if isOwner(userId)
                    && request.resource.data.id == userId
                    && request.resource.data.xp == 0
                    && request.resource.data.level == 1
                    && request.resource.data.get('premium', false) == false
                    && request.resource.data.get('isPremium', false) == false
                    && request.resource.data.get('banned', false) == false
                    && request.resource.data.referralCount == 0
                    && request.resource.data.badges.size() == 0
                    && request.resource.data.keys().hasOnly([
                         'id', 'name', 'photoUrl', 'bio', 'city', 'website',
                         'premium', 'xp', 'level', 'badges', 'banned',
                         'referralCount', 'referredByUserId', 'createdAt'
                       ]);

      allow update: if (
        // El dueño puede editar perfil.
        // isPremium, xp, level, badges, banned: solo Cloud Functions/scripts via Admin SDK.
        isOwner(userId)
        && changedKeys().hasOnly([
          // 'language' es el idioma del móvil, que la app refresca al entrar. Lo necesita el
          // servidor para redactar los push: las Cloud Functions escriben el título y el
          // cuerpo, y sin esto no tienen forma de saber en qué idioma hablarle a cada uno.
          'name', 'bio', 'city', 'website', 'photoUrl', 'fcmToken', 'language',
          'referralCode', 'referredByUserId'
        ])
        // referralCode solo se puede escribir si antes no existía
        && (!changedKeys().hasAll(['referralCode'])
            || !('referralCode' in resource.data)
            || resource.data.referralCode == '')
        // referredByUserId solo si estaba vacío (no se puede cambiar una vez puesto)
        && (!changedKeys().hasAll(['referredByUserId'])
            || resource.data.referredByUserId == '')
      );
      // referralCount y XP solo los escribe onReferralCreated Cloud Function via Admin SDK

      allow delete: if isOwner(userId);

      // Lista de bloqueados. SOLO el dueño, ni leer ni escribir nadie más: saber a quién
      // has bloqueado es información tuya. Las reglas de arriba la consultan igual, porque
      // se evalúan en el servidor y no pasan por esta restricción.
      match /bloqueados/{bloqueadoId} {
        allow read, write: if isOwner(userId);
      }

      // Token de avisos, uno por móvil. SOLO el dueño, a diferencia del documento de
      // perfil de arriba, que lo lee cualquiera con sesión iniciada (`isSignedIn`) —
      // y ahí es justo donde vive hoy el `fcmToken`, al alcance de cualquier cuenta.
      //
      // El plan de migración, en dos versiones, porque un token NO se puede rellenar
      // desde el servidor: solo el móvil conoce el suyo. Si el servidor cambiara de
      // sitio antes de que la app escriba aquí, todo el que siguiera en una versión
      // anterior se quedaría sin avisos.
      //   v22 (esta): la app escribe en los DOS sitios. El servidor sigue leyendo el
      //               campo del perfil y no se entera de nada.
      //   después:    con la v22 repartida, las Cloud Functions pasan a leer de aquí
      //               (todos los dispositivos, no uno) y se borra `fcmToken` del
      //               perfil, con su línea del `hasOnly` de arriba.
      //
      // De paso arregla lo de los dos móviles: `fcmToken` es un campo único, así que
      // el segundo teléfono pisaba el token del primero y cerrar sesión en uno dejaba
      // al otro sin avisos. Aquí cada instalación tiene su documento.
      match /dispositivos/{deviceId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── BORRADOS INCOMPLETOS ───────────────────────────────────
    // Lo que deleteUserAccount no consiguió limpiar, anotado para reintentarlo a mano
    // con functions/scripts/retryDeletions.js. Cerrado del todo: lo escribe y lo lee
    // solo el Admin SDK, que no pasa por estas reglas. Tiene uids de cuentas ya
    // borradas, así que no hay nadie a quien dárselo ni motivo para enseñarlo.
    match /borradosIncompletos/{uid} {
      allow read, write: if false;
    }

    // ── VENUES ─────────────────────────────────────────────────
    // Identidad canónica del local (doc id == place_id de Google Places).
    // Lectura pública como los platos; escritura SOLO desde la Cloud Function
    // resolveVenue via Admin SDK. El cliente nunca escribe aquí: este documento lo
    // ven todos los usuarios, así que si fuera escribible desde la app cualquiera
    // podría renombrar un local para toda la comunidad. Ver docs/VENUES.md.
    match /venues/{venueId} {
      allow read: if true;
      allow write: if false;
    }

    // ── PLATES ─────────────────────────────────────────────────
    match /plates/{plateId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.addedByUserId == request.auth.uid
                    && request.resource.data.averageScore == 0
                    && request.resource.data.totalRatings == 0
                    && request.resource.data.likes == 0
                    && request.resource.data.reportCount == 0
                    && request.resource.data.status == "pending"
                    // Agregados del rediseño: los siembra approveplate via Admin SDK, nunca el
                    // cliente. El precio del autor viaja en SU rating (pricePaidCents) y la
                    // Cloud Function lo agrega aquí. Ver docs/RATINGS.md §2.
                    && request.resource.data.get('rankingScore', 0) == 0
                    && request.resource.data.get('wouldOrderAgainCount', 0) == 0
                    && request.resource.data.get('wouldOrderAgainResponses', 0) == 0
                    && request.resource.data.get('priceMedianCents', null) == null
                    && request.resource.data.get('priceReportCount', 0) == 0
                    && request.resource.data.get('priceUpdatedAt', 0) == 0
                    // Identidad canónica: el plato debe colgar de un local ya resuelto
                    // por la CF resolveVenue, y su id ha de ser {venueId}__{dishSlug}
                    // para que el deduplicado lo imponga Firestore (ver docs/VENUES.md).
                    && request.resource.data.venueId is string
                    && request.resource.data.venueId.size() > 0
                    && request.resource.data.dishSlug is string
                    && request.resource.data.dishSlug.size() > 0
                    && plateId == request.resource.data.venueId + '__' + request.resource.data.dishSlug
                    && exists(/databases/$(database)/documents/venues/$(request.resource.data.venueId))
                    && request.resource.data.keys().hasOnly([
                         'id', 'name', 'description', 'category',
                         'restaurantName', 'restaurantAddress',
                         'city', 'country', 'countryCode', 'latitude', 'longitude',
                         'imageUrl', 'addedByUserId', 'addedByUserName',
                         'averageScore', 'totalRatings', 'createdAt',
                         'likes', 'likedByUsers', 'reportCount', 'status',
                         'venueId', 'dishSlug',
                         'rankingScore', 'wouldOrderAgainCount', 'wouldOrderAgainResponses',
                         'priceMedianCents', 'priceReportCount', 'priceUpdatedAt'
                       ]);

      allow update: if isSignedIn() && (
        // Dueño: solo puede editar description una vez aprobado
        (
          request.auth.uid == resource.data.addedByUserId
          && changedKeys().hasOnly(['description'])
          && resource.data.status == 'approved'
        ) ||
        // Like: el usuario NO estaba en la lista, ahora SÍ
        (
          changedKeys().hasOnly(['likes', 'likedByUsers'])
          && !resource.data.likedByUsers.hasAll([request.auth.uid])
          && request.resource.data.likedByUsers.hasAll(resource.data.likedByUsers)
          && request.resource.data.likedByUsers.hasAll([request.auth.uid])
          && request.resource.data.likedByUsers.size() == resource.data.likedByUsers.size() + 1
          && request.resource.data.likes == resource.data.likes + 1
        ) ||
        // Unlike: el usuario SÍ estaba en la lista, ahora NO
        (
          changedKeys().hasOnly(['likes', 'likedByUsers'])
          && resource.data.likedByUsers.hasAll([request.auth.uid])
          && !request.resource.data.likedByUsers.hasAll([request.auth.uid])
          && resource.data.likedByUsers.hasAll(request.resource.data.likedByUsers)
          && request.resource.data.likedByUsers.size() == resource.data.likedByUsers.size() - 1
          && request.resource.data.likes == resource.data.likes - 1
          && request.resource.data.likes >= 0
        ) ||
        // Reportes: solo incremento de 1
        (
          changedKeys().hasOnly(['reportCount'])
          && request.resource.data.reportCount == resource.data.reportCount + 1
          && denunciaCreadaAhora(plateId)
        )
        // Los agregados los escribe solo Cloud Functions via Admin SDK: averageScore,
        // totalRatings, rankingScore, wouldOrderAgainCount y los tres campos de precio.
        // Ninguna rama de arriba los incluye en su hasOnly, así que quedan fuera.
      );

      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.addedByUserId;
    }

    // ── RATINGS ────────────────────────────────────────────────
    // ⚠️ Conviven dos formatos mientras quede parque en v12 o anterior (ver docs/RATINGS.md):
    // el viejo manda `valueScore` y no manda `satisfactionScore`; el nuevo al revés. Por eso
    // los dos son OPCIONALES aquí. Endurecerlo (exigir los nuevos, prohibir `valueScore`) es
    // un paso posterior, cuando las instalaciones hayan rotado — hacerlo antes deja sin poder
    // valorar a quien no haya actualizado.
    match /ratings/{ratingId} {
      allow read: if true;
      // ID determinista plateId_userId: un usuario solo puede valorar un plato una vez
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && ratingId == request.resource.data.plateId + "_" + request.auth.uid
                    && scoreOk(request.resource.data.flavorScore)
                    && scoreOk(request.resource.data.presentationScore)
                    && scoreOk(request.resource.data.averageScore)
                    && optScoreOk(request.resource.data, 'satisfactionScore')
                    && legacyScoreOk(request.resource.data)
                    && priceOk(request.resource.data)
                    && flagOk(request.resource.data, 'wouldOrderAgain')
                    && flagOk(request.resource.data, 'verifiedAtVenue')
                    && request.resource.data.get('reportCount', 0) == 0
                    && !('processed' in request.resource.data)
                    // Y tampoco el sello de onRatingUpdated, que lo escribe solo el
                    // servidor. El `hasOnly` del update de abajo ya impide tocarlo una
                    // vez creada, pero el create admite campos extra: sin esto una
                    // valoración podría nacer declarando que ya está incorporada al
                    // plato con la nota que le diera la gana, y en la primera edición
                    // la media del plato se movería en esa diferencia inventada.
                    && !('appliedAvg' in request.resource.data)
                    && !('appliedWouldOrderAgain' in request.resource.data)
                    // Tampoco se valora el plato de alguien con quien hay bloqueo: si no,
                    // el bloqueado seguiría pudiendo hundir la nota de quien le bloqueó.
                    && !bloqueoEntre(autorDelPlato(request.resource.data.plateId))
                    && !('aggregatedEventId' in request.resource.data);
      // Reportar una valoración: mismo patrón que plates/comments (solo +1, y el id
      // determinista del reporte impide contarlo dos veces). Hacía falta porque la
      // declaración "lo he probado" no se puede comprobar: si alguien miente para hundir o
      // inflar un plato, esto es lo único que permite señalarlo.
      allow update: if isSignedIn()
                    && changedKeys().hasOnly(['reportCount'])
                    && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
                    && denunciaCreadaAhora(ratingId);
      // El autor puede actualizar sus puntuaciones y comentario (no userId/plateId/createdAt)
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && changedKeys().hasOnly([
                         'flavorScore', 'presentationScore', 'satisfactionScore',
                         'valueScore', 'averageScore', 'comment',
                         'wouldOrderAgain', 'pricePaidCents'
                       ])
                    && scoreOk(request.resource.data.flavorScore)
                    && scoreOk(request.resource.data.presentationScore)
                    && scoreOk(request.resource.data.averageScore)
                    && optScoreOk(request.resource.data, 'satisfactionScore')
                    && legacyScoreOk(request.resource.data)
                    && priceOk(request.resource.data)
                    && flagOk(request.resource.data, 'wouldOrderAgain');
      // Sin delete: evita el exploit "borrar y volver a votar"
      allow delete: if false;
    }

    // ── COMMENTS ───────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    // No se comenta el plato de alguien con quien hay bloqueo de por medio.
                    && !bloqueoEntre(autorDelPlato(request.resource.data.plateId));
      // Reportes: solo incremento de 1, mismo patrón que plates.reportCount.
      // get('reportCount', 0): un comentario creado por una app anterior a esta
      // feature no tiene el campo — sin el default, resource.data.reportCount sería
      // null y "null + 1" rompe la regla, bloqueando el reporte justo en el contenido
      // más antiguo (y más probable que necesite reportarse primero).
      allow update: if isSignedIn()
                    && changedKeys().hasOnly(['reportCount'])
                    && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
                    && denunciaCreadaAhora(commentId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── SAVES ──────────────────────────────────────────────────
    match /saves/{saveId} {
      // El propio usuario ve sus guardados; el autor del plato puede ver quién lo ha
      // guardado ("quién ha interactuado" — ver PlateDetailViewModel). Esto fue una
      // función de Premium hasta el 2026-11-22; ahora la tiene cualquier autor, y la
      // regla no cambia porque nunca miró el premium, solo la autoría del plato.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/plates/$(resource.data.plateId)).data.addedByUserId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── COLLECTIONS ────────────────────────────────────────────
    match /collections/{collectionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── CHALLENGES ─────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if false;
      // Participar: solo si NO participaba antes, añade exactamente su uid, incrementa en 1
      allow update: if isSignedIn()
                    && changedKeys().hasOnly(['participantIds', 'participantCount'])
                    && !resource.data.participantIds.hasAll([request.auth.uid])
                    && request.resource.data.participantIds.hasAll(resource.data.participantIds)
                    && request.resource.data.participantIds.hasAll([request.auth.uid])
                    && request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1
                    && request.resource.data.participantCount == resource.data.participantCount + 1;
      allow delete: if false;
    }

    // ── REPORTS ────────────────────────────────────────────────
    match /reports/{reportId} {
      // El id es determinista: "{userId}_{plateId}" o "{userId}_{commentId}". Permitir
      // el get de tu propio prefijo es lo que necesita la transacción de reportPlate/
      // reportComment para comprobar si ya reportaste algo (funciona también cuando el
      // documento aún no existe, a diferencia de comprobar resource.data). Nadie puede
      // listar ni leer reportes de otro usuario.
      allow get: if isSignedIn() && reportId.split('_')[0] == request.auth.uid;
      allow list: if false;
      // El `create` tiene que comprobar el **id**, no solo el campo. Mirando únicamente
      // `reportedByUserId` cualquiera podía crear `reports/{uidDeOtro}_{plateId}`
      // declarándose autor: la transacción de reportPlate/reportComment da por hecho que
      // "el documento existe" significa "ya lo denuncié yo" (ver PlateDetailViewModel),
      // así que a la víctima le quedaba ese plato marcado como ya denunciado y no podía
      // denunciarlo nunca. Y como aquí no hay `update` ni `delete`, el documento plantado
      // solo se quitaba con el Admin SDK. Se exige el mismo prefijo que el `get` de
      // arriba, que ya lleva tiempo en producción. `split('_')[0]` es seguro aunque el
      // plateId lleve guiones bajos (p. ej. "ChIJ17p_qV9HoBIRTRSfEBcZuhk__arroz-illa"):
      // coge el primer segmento, que es el uid.
      allow create: if isSignedIn()
                    && reportId.split('_')[0] == request.auth.uid
                    && request.resource.data.reportedByUserId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── FOLLOWS ────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      // ID determinista followerId_followingId: evita duplicados
      allow create: if isSignedIn()
                    && request.resource.data.followerId == request.auth.uid
                    && followId == request.resource.data.followerId + "_" + request.resource.data.followingId
                    // Ni sigues a quien bloqueaste ni te sigue quien te bloqueó.
                    && !bloqueoEntre(request.resource.data.followingId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // ── NOTIFICATIONS ──────────────────────────────────────────
    match /notifications/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{itemId} {
        allow read, update, delete: if isOwner(userId);
        // El cliente SOLO puede crear notificaciones de tipo 'like'. Los tipos
        // 'rating', 'comment', 'moderation_approved' y 'moderation_rejected' los
        // escribe el Admin SDK desde Cloud Functions, que no pasa por estas reglas.
        // Sin restringir el type, cualquier usuario podía crear en el buzón de otro
        // un 'moderation_rejected' — y como onNotificationCreated dispara push, le
        // llegaba al móvil un "tu plato no cumple las normas" que parecía del sistema.
        // fromUserId debe ser además el propio usuario que crea la notificación.
        allow create: if isSignedIn()
                      && request.resource.data.keys().hasAll(['type', 'fromUserId', 'createdAt'])
                      && request.resource.data.type == 'like'
                      && request.resource.data.fromUserId == request.auth.uid
                      && request.resource.data.isRead == false
                      // Y que el bloqueado no pueda meterte nada en el buzón: un 'like'
                      // dispara push, así que sin esto el bloqueo se saltaría por ahí.
                      && !bloqueoEntre(userId);
      }
    }

    // ── REFERRALS ──────────────────────────────────────────────
    match /referrals/{referralId} {
      // El referido puede leer SU propio referral, y solo ese. Hace falta porque
      // applyReferralCode hace tx.get sobre este documento dentro de la transaccion para
      // no contar dos veces la misma invitacion; con `read: if false` esa lectura fallaba
      // siempre y el alta por invitacion no funcionaba para nadie.
      //
      // Se filtra por el ID, no por resource.data, a proposito: en el momento del tx.get
      // el documento normalmente NO existe todavia, y entonces `resource` es null y
      // cualquier condicion sobre su contenido falla. El ID es determinista
      // (referrerId_referredId) y los uid de Firebase no llevan "_", asi que split da
      // exactamente dos partes.
      allow get: if isSignedIn() && referralId.split('_')[1] == request.auth.uid;
      allow list: if false;
      // ID determinista referrerId_referredId: evita que un usuario cree múltiples
      // referrals para el mismo referidor y acumule XP varias veces.
      allow create: if isSignedIn()
                    && request.resource.data.referredId == request.auth.uid
                    && request.resource.data.referrerId != request.auth.uid
                    && referralId == request.resource.data.referrerId + "_" + request.auth.uid;
      allow update, delete: if false;
    }

    // ── LEAGUES ────────────────────────────────────────────────
    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow write: if false; // Only Cloud Functions via Admin SDK
      match /entries/{userId} {
        allow read: if isSignedIn();
        allow write: if false; // Only Cloud Functions via Admin SDK
      }
    }
  }
}
