rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Ejes de una valoración: 1..10. Ver docs/RATINGS.md.
    function scoreOk(v) { return v is number && v >= 1 && v <= 10; }
    // Campo opcional durante la convivencia de formatos: si no viene (cliente v12) o viene
    // nulo, se acepta; si viene con valor, tiene que estar en rango.
    function optScoreOk(data, key) {
      return data.get(key, null) == null || scoreOk(data.get(key, null));
    }
    // Precio pagado, en céntimos. Tope de cordura en 1.000 € para frenar erratas de teclado;
    // los valores raros que pasen el filtro los absorbe la mediana (ver docs/RATINGS.md §1.3).
    function priceOk(data) {
      return data.get('pricePaidCents', null) == null || (
        data.pricePaidCents is int
        && data.pricePaidCents > 0
        && data.pricePaidCents <= 100000
      );
    }
    function flagOk(data, key) {
      return data.get(key, null) == null || data.get(key, null) is bool;
    }
    // `valueScore` es el eje retirado (Precio/Calidad). ⚠️ El data class Rating del cliente lo
    // sigue serializando con su valor por defecto **0** aunque ya no se use — un data class de
    // Kotlin manda TODOS sus campos. Por eso aquí 0 vale como "no aplica": exigirle el rango
    // 1..10 dejaba sin poder valorar a todo el mundo (visto en el emulador con un
    // PERMISSION_DENIED real, 2026-09-20).
    function legacyScoreOk(data) {
      return data.get('valueScore', null) == null
          || data.valueScore == 0
          || scoreOk(data.valueScore);
    }

    // ── USERS ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();

      // Crear perfil: valores por defecto obligatorios para evitar XP/Premium falsos
      // Ojo con el booleano premium: el modelo Kotlin lo llama `isPremium`, pero el
      // mapper de Firestore le quita el prefijo `is` al getter y en el documento el
      // campo acaba siendo `premium`. Comprobamos las dos grafías con get(campo, false)
      // para no depender de ese detalle: falte el campo o venga con cualquiera de los
      // dos nombres, nadie puede crearse premium.
      // ⚠️ La lista blanca de abajo tiene los campos del data class User. Si se añade un
      // campo al modelo sin añadirlo aquí, falla TODA creación de usuarios (igual que en
      // plates). Y ojo: va `premium`, NO `isPremium` — ver la nota del prefijo `is`.
      allow create: if isOwner(userId)
                    && request.resource.data.id == userId
                    && request.resource.data.xp == 0
                    && request.resource.data.level == 1
                    && request.resource.data.get('premium', false) == false
                    && request.resource.data.get('isPremium', false) == false
                    && request.resource.data.get('banned', false) == false
                    && request.resource.data.referralCount == 0
                    && request.resource.data.badges.size() == 0
                    && request.resource.data.keys().hasOnly([
                         'id', 'name', 'photoUrl', 'bio', 'city', 'website',
                         'premium', 'xp', 'level', 'badges', 'banned',
                         'referralCount', 'referredByUserId', 'createdAt'
                       ]);

      allow update: if (
        // El dueño puede editar perfil.
        // isPremium, xp, level, badges, banned: solo Cloud Functions/scripts via Admin SDK.
        isOwner(userId)
        && changedKeys().hasOnly([
          'name', 'bio', 'city', 'website', 'photoUrl', 'fcmToken',
          'referralCode', 'referredByUserId'
        ])
        // referralCode solo se puede escribir si antes no existía
        && (!changedKeys().hasAll(['referralCode'])
            || !('referralCode' in resource.data)
            || resource.data.referralCode == '')
        // referredByUserId solo si estaba vacío (no se puede cambiar una vez puesto)
        && (!changedKeys().hasAll(['referredByUserId'])
            || resource.data.referredByUserId == '')
      );
      // referralCount y XP solo los escribe onReferralCreated Cloud Function via Admin SDK

      allow delete: if isOwner(userId);
    }

    // ── VENUES ─────────────────────────────────────────────────
    // Identidad canónica del local (doc id == place_id de Google Places).
    // Lectura pública como los platos; escritura SOLO desde la Cloud Function
    // resolveVenue via Admin SDK. El cliente nunca escribe aquí: este documento lo
    // ven todos los usuarios, así que si fuera escribible desde la app cualquiera
    // podría renombrar un local para toda la comunidad. Ver docs/VENUES.md.
    match /venues/{venueId} {
      allow read: if true;
      allow write: if false;
    }

    // ── PLATES ─────────────────────────────────────────────────
    match /plates/{plateId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.addedByUserId == request.auth.uid
                    && request.resource.data.averageScore == 0
                    && request.resource.data.totalRatings == 0
                    && request.resource.data.likes == 0
                    && request.resource.data.reportCount == 0
                    && request.resource.data.status == "pending"
                    // Agregados del rediseño: los siembra approveplate via Admin SDK, nunca el
                    // cliente. El precio del autor viaja en SU rating (pricePaidCents) y la
                    // Cloud Function lo agrega aquí. Ver docs/RATINGS.md §2.
                    && request.resource.data.get('rankingScore', 0) == 0
                    && request.resource.data.get('wouldOrderAgainCount', 0) == 0
                    && request.resource.data.get('wouldOrderAgainResponses', 0) == 0
                    && request.resource.data.get('priceMedianCents', null) == null
                    && request.resource.data.get('priceReportCount', 0) == 0
                    && request.resource.data.get('priceUpdatedAt', 0) == 0
                    // Identidad canónica: el plato debe colgar de un local ya resuelto
                    // por la CF resolveVenue, y su id ha de ser {venueId}__{dishSlug}
                    // para que el deduplicado lo imponga Firestore (ver docs/VENUES.md).
                    && request.resource.data.venueId is string
                    && request.resource.data.venueId.size() > 0
                    && request.resource.data.dishSlug is string
                    && request.resource.data.dishSlug.size() > 0
                    && plateId == request.resource.data.venueId + '__' + request.resource.data.dishSlug
                    && exists(/databases/$(database)/documents/venues/$(request.resource.data.venueId))
                    && request.resource.data.keys().hasOnly([
                         'id', 'name', 'description', 'category',
                         'restaurantName', 'restaurantAddress',
                         'city', 'country', 'latitude', 'longitude',
                         'imageUrl', 'addedByUserId', 'addedByUserName',
                         'averageScore', 'totalRatings', 'createdAt',
                         'likes', 'likedByUsers', 'reportCount', 'status',
                         'venueId', 'dishSlug',
                         'rankingScore', 'wouldOrderAgainCount', 'wouldOrderAgainResponses',
                         'priceMedianCents', 'priceReportCount', 'priceUpdatedAt'
                       ]);

      allow update: if isSignedIn() && (
        // Dueño: solo puede editar description una vez aprobado
        (
          request.auth.uid == resource.data.addedByUserId
          && changedKeys().hasOnly(['description'])
          && resource.data.status == 'approved'
        ) ||
        // Like: el usuario NO estaba en la lista, ahora SÍ
        (
          changedKeys().hasOnly(['likes', 'likedByUsers'])
          && !resource.data.likedByUsers.hasAll([request.auth.uid])
          && request.resource.data.likedByUsers.hasAll(resource.data.likedByUsers)
          && request.resource.data.likedByUsers.hasAll([request.auth.uid])
          && request.resource.data.likedByUsers.size() == resource.data.likedByUsers.size() + 1
          && request.resource.data.likes == resource.data.likes + 1
        ) ||
        // Unlike: el usuario SÍ estaba en la lista, ahora NO
        (
          changedKeys().hasOnly(['likes', 'likedByUsers'])
          && resource.data.likedByUsers.hasAll([request.auth.uid])
          && !request.resource.data.likedByUsers.hasAll([request.auth.uid])
          && resource.data.likedByUsers.hasAll(request.resource.data.likedByUsers)
          && request.resource.data.likedByUsers.size() == resource.data.likedByUsers.size() - 1
          && request.resource.data.likes == resource.data.likes - 1
          && request.resource.data.likes >= 0
        ) ||
        // Reportes: solo incremento de 1
        (
          changedKeys().hasOnly(['reportCount'])
          && request.resource.data.reportCount == resource.data.reportCount + 1
        )
        // Los agregados los escribe solo Cloud Functions via Admin SDK: averageScore,
        // totalRatings, rankingScore, wouldOrderAgainCount y los tres campos de precio.
        // Ninguna rama de arriba los incluye en su hasOnly, así que quedan fuera.
      );

      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.addedByUserId;
    }

    // ── RATINGS ────────────────────────────────────────────────
    // ⚠️ Conviven dos formatos mientras quede parque en v12 o anterior (ver docs/RATINGS.md):
    // el viejo manda `valueScore` y no manda `satisfactionScore`; el nuevo al revés. Por eso
    // los dos son OPCIONALES aquí. Endurecerlo (exigir los nuevos, prohibir `valueScore`) es
    // un paso posterior, cuando las instalaciones hayan rotado — hacerlo antes deja sin poder
    // valorar a quien no haya actualizado.
    match /ratings/{ratingId} {
      allow read: if true;
      // ID determinista plateId_userId: un usuario solo puede valorar un plato una vez
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && ratingId == request.resource.data.plateId + "_" + request.auth.uid
                    && scoreOk(request.resource.data.flavorScore)
                    && scoreOk(request.resource.data.presentationScore)
                    && scoreOk(request.resource.data.averageScore)
                    && optScoreOk(request.resource.data, 'satisfactionScore')
                    && legacyScoreOk(request.resource.data)
                    && priceOk(request.resource.data)
                    && flagOk(request.resource.data, 'wouldOrderAgain')
                    && flagOk(request.resource.data, 'verifiedAtVenue')
                    && !('processed' in request.resource.data);
      // El autor puede actualizar sus puntuaciones y comentario (no userId/plateId/createdAt)
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && changedKeys().hasOnly([
                         'flavorScore', 'presentationScore', 'satisfactionScore',
                         'valueScore', 'averageScore', 'comment',
                         'wouldOrderAgain', 'pricePaidCents'
                       ])
                    && scoreOk(request.resource.data.flavorScore)
                    && scoreOk(request.resource.data.presentationScore)
                    && scoreOk(request.resource.data.averageScore)
                    && optScoreOk(request.resource.data, 'satisfactionScore')
                    && legacyScoreOk(request.resource.data)
                    && priceOk(request.resource.data)
                    && flagOk(request.resource.data, 'wouldOrderAgain');
      // Sin delete: evita el exploit "borrar y volver a votar"
      allow delete: if false;
    }

    // ── COMMENTS ───────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Reportes: solo incremento de 1, mismo patrón que plates.reportCount.
      // get('reportCount', 0): un comentario creado por una app anterior a esta
      // feature no tiene el campo — sin el default, resource.data.reportCount sería
      // null y "null + 1" rompe la regla, bloqueando el reporte justo en el contenido
      // más antiguo (y más probable que necesite reportarse primero).
      allow update: if isSignedIn()
                    && changedKeys().hasOnly(['reportCount'])
                    && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── SAVES ──────────────────────────────────────────────────
    match /saves/{saveId} {
      // El propio usuario ve sus guardados; el autor del plato puede ver quién lo ha
      // guardado (función Premium "quién ha interactuado" — ver PlateDetailViewModel).
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/plates/$(resource.data.plateId)).data.addedByUserId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── COLLECTIONS ────────────────────────────────────────────
    match /collections/{collectionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── CHALLENGES ─────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if false;
      // Participar: solo si NO participaba antes, añade exactamente su uid, incrementa en 1
      allow update: if isSignedIn()
                    && changedKeys().hasOnly(['participantIds', 'participantCount'])
                    && !resource.data.participantIds.hasAll([request.auth.uid])
                    && request.resource.data.participantIds.hasAll(resource.data.participantIds)
                    && request.resource.data.participantIds.hasAll([request.auth.uid])
                    && request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1
                    && request.resource.data.participantCount == resource.data.participantCount + 1;
      allow delete: if false;
    }

    // ── REPORTS ────────────────────────────────────────────────
    match /reports/{reportId} {
      // El id es determinista: "{userId}_{plateId}" o "{userId}_{commentId}". Permitir
      // el get de tu propio prefijo es lo que necesita la transacción de reportPlate/
      // reportComment para comprobar si ya reportaste algo (funciona también cuando el
      // documento aún no existe, a diferencia de comprobar resource.data). Nadie puede
      // listar ni leer reportes de otro usuario.
      allow get: if isSignedIn() && reportId.split('_')[0] == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.reportedByUserId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── FOLLOWS ────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      // ID determinista followerId_followingId: evita duplicados
      allow create: if isSignedIn()
                    && request.resource.data.followerId == request.auth.uid
                    && followId == request.resource.data.followerId + "_" + request.resource.data.followingId;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // ── NOTIFICATIONS ──────────────────────────────────────────
    match /notifications/{userId} {
      allow read, write: if isOwner(userId);
      match /items/{itemId} {
        allow read, update, delete: if isOwner(userId);
        // fromUserId debe ser el propio usuario que crea la notificación
        allow create: if isSignedIn()
                      && request.resource.data.keys().hasAll(['type', 'fromUserId', 'createdAt'])
                      && request.resource.data.fromUserId == request.auth.uid
                      && request.resource.data.isRead == false;
      }
    }

    // ── REFERRALS ──────────────────────────────────────────────
    match /referrals/{referralId} {
      allow read: if false;
      // ID determinista referrerId_referredId: evita que un usuario cree múltiples
      // referrals para el mismo referidor y acumule XP varias veces.
      allow create: if isSignedIn()
                    && request.resource.data.referredId == request.auth.uid
                    && request.resource.data.referrerId != request.auth.uid
                    && referralId == request.resource.data.referrerId + "_" + request.auth.uid;
      allow update, delete: if false;
    }

    // ── LEAGUES ────────────────────────────────────────────────
    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow write: if false; // Only Cloud Functions via Admin SDK
      match /entries/{userId} {
        allow read: if isSignedIn();
        allow write: if false; // Only Cloud Functions via Admin SDK
      }
    }
  }
}
