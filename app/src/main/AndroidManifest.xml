<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Localización: para ofrecer los locales cercanos al publicar un plato (quien
         fotografía un plato está en el restaurante). Es opcional — sin permiso se
         puede buscar el local por texto. Declararlo en el Data safety de Play. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".FoodRankerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodRanker"
        tools:targetApi="31">

        <!-- ✅ AdMob App ID — directamente en application, NO dentro de provider -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6291919286572988~5455770258"/>

        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <!-- FileProvider para compartir imágenes -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM Notificaciones -->
        <service
            android:name=".utils.FoodRankerMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Icono/color por defecto para las notificaciones push que Android dibuja él
             mismo, SIN pasar por FoodRankerMessagingService.onMessageReceived: pasa con
             cualquier push con bloque "notification" (like/comentario/moderación, ver
             functions/src/index.ts) cuando la app está en segundo plano o cerrada — solo
             el caso en primer plano pasa por onMessageReceived → NotificationHelper.show(),
             que ya usa este mismo icono. Sin esto, Android usaba su propio icono por
             defecto (distinto al tenedor y cuchillo), reportado por el usuario. Los
             recordatorios locales (DailyReminderWorker) no son FCM, así que nunca
             dependieron de esto — de ahí que solo fallara con likes/comentarios. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- singleTop no es cosmetico: es la unica actividad de la app y recibe TODOS
             los enlaces y TODAS las notificaciones. Con el "standard" de por defecto,
             abrir un enlace compartido con la app ya abierta apilaba una SEGUNDA
             MainActivity en la misma tarea (comprobado en el emulador: Hist #0 y
             Hist #1 en la tarea t14): el usuario veia la app arrancar de nuevo por el
             splash, y "atras" le devolvia a su copia anterior en vez de salir. Y las
             notificaciones, que traen FLAG_ACTIVITY_CLEAR_TOP, destruian y recreaban
             la actividad perdiendo el estado. Con singleTop se reutiliza la instancia
             y entra por onNewIntent, que es justo lo que MainActivity ya sobrescribe.
             Nada de esto se podia ver antes de la v19 porque los enlaces estaban
             muertos y nadie llegaba a abrir uno. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FoodRanker.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Enlace público de perfil (cuando exista dominio configurado).
                 Prueba en emulador: adb shell am start -a VIEW -d "foodranker://user/TU_UID" … -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="foodranker"
                    android:host="user"
                    android:pathPrefix="/" />
            </intent-filter>
            <!-- foodranker://plate/{id} — DeepLinkParser.kt ya lo soporta -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="foodranker"
                    android:host="plate"
                    android:pathPrefix="/" />
            </intent-filter>
            <!-- foodranker://invite/{code} — el respaldo de hosting/public/open.html.
                 El botón "Ya tengo la app" de esa página manda a foodranker://<tipo>/<id>
                 para los tres tipos de enlace, porque el esquema propio no necesita
                 verificación de dominio y funciona aunque los App Links no estén
                 verificados todavía. Faltaba este filtro: con plate y user el botón
                 abría la app, y con una invitación no hacía nada. Justo el único de los
                 tres que nunca ha funcionado (0 documentos en `referrals`). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="foodranker"
                    android:host="invite"
                    android:pathPrefix="/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="foodranker.web.app"
                    android:pathPrefix="/user" />
            </intent-filter>
            <!-- Deep link plato: https://foodranker.web.app/plate/{id} -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="foodranker.web.app"
                    android:pathPrefix="/plate" />
            </intent-filter>
            <!-- Deep link invitación: https://foodranker.web.app/invite/{code} -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="foodranker.web.app"
                    android:pathPrefix="/invite" />
            </intent-filter>
        </activity>

    </application>

</manifest>